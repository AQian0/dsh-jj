{
  "name": "@aqian0/dsh-jj",
  "version": "0.4.0",
  "description": "First-class Jujutsu (jj) support for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "jj",
    "jujutsu"
  ],
  "homepage": "https://github.com/AQian0/dsh-jj#readme",
  "bugs": {
    "url": "https://github.com/AQian0/dsh-jj/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AQian0/dsh-jj.git"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "tools/locale/*.json",
    "guard/locale/*.json",
    "icon.svg",
    "src/**/*.ts"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./guard": {
      "types": "./lib/types/guard.d.ts",
      "default": "./lib/guard.js"
    },
    "./detect": {
      "types": "./lib/types/detect.d.ts",
      "default": "./lib/detect.js"
    },
    "./git-command": {
      "types": "./lib/types/git-command.d.ts",
      "default": "./lib/git-command.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./tools/locale/*.json": "./tools/locale/*.json",
    "./tools/icon": "./icon.svg",
    "./guard/locale/*.json": "./guard/locale/*.json",
    "./guard/icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "check": "vp check --deny-warnings",
    "check:fix": "vp check --fix",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:unit": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='lib/**' \"test/**/*.test.ts\"",
    "test": "pnpm run check && pnpm run typecheck && pnpm run test:unit"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "packageManager": "pnpm@12.16.1",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
