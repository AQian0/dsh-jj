{
  "name": "@aqian0/dsh-jj",
  "version": "0.2.0",
  "description": "First-class Jujutsu (jj) support for DeepSeek Harness: repository detection, git-confusion guard, and jj-native tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AQian0/dsh-jj.git"
  },
  "homepage": "https://github.com/AQian0/dsh-jj#readme",
  "bugs": {
    "url": "https://github.com/AQian0/dsh-jj/issues"
  },
  "keywords": [
    "jujutsu",
    "jj",
    "deepseek-harness"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./guard": {
      "types": "./lib/types/guard.d.ts",
      "default": "./lib/guard.js"
    },
    "./detect": {
      "types": "./lib/types/detect.d.ts",
      "default": "./lib/detect.js"
    },
    "./git-command": {
      "types": "./lib/types/git-command.d.ts",
      "default": "./lib/git-command.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./tools/locale/*.json": "./tools/locale/*.json",
    "./tools/icon": "./icon.svg",
    "./guard/locale/*.json": "./guard/locale/*.json",
    "./guard/icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "tools/locale/*.json",
    "guard/locale/*.json",
    "icon.svg",
    "src/**/*.ts"
  ],
  "scripts": {
    "setup": "node scripts/setup-links.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test:unit": "node --test \"test/**/*.test.ts\"",
    "test": "node scripts/setup-links.ts && tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test \"test/**/*.test.ts\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
